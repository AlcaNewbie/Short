# Isi salah satu pasangan di bawah (otomatis terisi kalau pakai Upstash Redis
# lewat Vercel Marketplace). Tanpa ini, data hanya disimpan di memori (tidak permanen).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternatif nama (Vercel KV lama)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opsional: batas pembuatan link per IP per menit (default 15)
# RATE_LIMIT_PER_MIN=15
